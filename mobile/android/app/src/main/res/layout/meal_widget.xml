<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="12dp" android:paddingBottom="12dp" android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_name" android:textColor="#B8CBF9" android:textSize="12sp"
        android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="오늘 급식" android:textColor="#FFFFFF"
        android:textSize="20sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_menu" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="4dp" android:text="급식을 불러오는 중"
        android:textColor="#EEF3FF" android:textSize="14sp" android:gravity="top"
        android:maxLines="4" android:ellipsize="end"/>
</LinearLayout>
